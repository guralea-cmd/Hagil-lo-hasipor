rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /registrations/{regId} {
      allow create: if request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.phone is string
                     && request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    // Legacy story collection (no site form creates these any more).
    // Approved docs are publicly readable, and rules can't hide single fields,
    // so contact details are never allowed on the doc itself - they live in
    // story_contacts/{storyId}.
    match /stories/{storyId} {
      allow create: if request.resource.data.status == "pending"
                     && request.resource.data.keys().hasOnly(["name", "bio", "videoUrl", "videoPath", "status", "createdAt"])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.videoUrl is string;
      allow read: if resource.data.status == "approved" || request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Public part of a story submission. Approved docs are readable by anyone,
    // so phone / email / links are NOT allowed here - they go to
    // story_contacts/{submissionId}, written in the same batch (js/register.js).
    match /story_submissions/{submissionId} {
      allow create: if request.resource.data.status == "pending"
                     && request.resource.data.keys().hasOnly(["name", "age", "location", "story", "turningPoint", "today", "message", "photoUrls", "videoUrl", "utmSource", "utmMedium", "utmCampaign", "status", "createdAt"])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.story is string
                     && existsAfter(/databases/$(database)/documents/story_contacts/$(submissionId));
      allow read: if resource.data.status == "approved" || request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Private contact details of story_submissions/{submissionId} (same id).
    // Never publicly readable. The public may only create one together with a
    // brand-new pending submission in the same batch.
    match /story_contacts/{submissionId} {
      allow create: if request.auth != null
                    || (request.resource.data.keys().hasOnly(["phone", "email", "links", "createdAt"])
                        && request.resource.data.phone is string
                        && request.resource.data.email is string
                        && (!("links" in request.resource.data) || request.resource.data.links is string)
                        && !exists(/databases/$(database)/documents/story_submissions/$(submissionId))
                        && existsAfter(/databases/$(database)/documents/story_submissions/$(submissionId))
                        && getAfter(/databases/$(database)/documents/story_submissions/$(submissionId)).data.status == "pending");
      allow read, update, delete: if request.auth != null;
    }

    match /event_signups/{signupId} {
      allow create: if request.resource.data.firstName is string
                     && request.resource.data.firstName.size() > 0
                     && request.resource.data.phone is string
                     && request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    match /workshop_leads/{leadId} {
      allow create: if request.resource.data.firstName is string
                     && request.resource.data.firstName.size() > 0
                     && request.resource.data.lastName is string
                     && request.resource.data.phone is string
                     && request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    match /pilates_leads/{leadId} {
      allow create: if request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.phone is string
                     && request.resource.data.phone.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    // "בת כמה את באמת?" leads (bat-kama-next.html). 16.9.2026: only the fields the page writes,
    // each with a size limit, so nobody can flood the collection with arbitrary data.
    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    match /age_test_leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'phone', 'source', 'interest', 'site', 'page',
                         'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm',
                         'adId', 'adsetId', 'campaignId', 'fbclid',
                         'status', 'createdAt', 'result'])
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.name.size() <= 80
                     && request.resource.data.phone is string
                     && request.resource.data.phone.size() > 0
                     && request.resource.data.phone.size() <= 30
                     && request.resource.data.get('source', 'bat-kama-next') in ['bat-kama', 'bat-kama-next']
                     && request.resource.data.get('status', 'new') == 'new'
                     && request.resource.data.get('createdAt', request.time) == request.time
                     && optStr(request.resource.data, 'interest', 40)
                     && optStr(request.resource.data, 'site', 40)
                     && optStr(request.resource.data, 'page', 100)
                     && optStr(request.resource.data, 'utmSource', 200)
                     && optStr(request.resource.data, 'utmMedium', 200)
                     && optStr(request.resource.data, 'utmCampaign', 200)
                     && optStr(request.resource.data, 'utmContent', 200)
                     && optStr(request.resource.data, 'utmTerm', 200)
                     && optStr(request.resource.data, 'adId', 40)
                     && optStr(request.resource.data, 'adsetId', 40)
                     && optStr(request.resource.data, 'campaignId', 40)
                     && optStr(request.resource.data, 'fbclid', 300)
                     && (!('result' in request.resource.data)
                         || request.resource.data.result == null
                         || (request.resource.data.result is map && request.resource.data.result.size() <= 40));
      allow read, update, delete: if request.auth != null;
    }

    match /contact_submissions/{submissionId} {
      allow create: if request.resource.data.name is string
                     && request.resource.data.name.size() > 0
                     && request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    // Public part of a banner-ad request. Approved docs are readable by anyone
    // (js/banner-display.js), so contactName / phone / email / notes are NOT
    // allowed here - they go to ad_contacts/{submissionId} in the same batch
    // (js/advertise.js).
    match /ad_submissions/{submissionId} {
      allow create: if request.resource.data.status == "pending"
                     && request.resource.data.keys().hasOnly(["advertiserName", "page", "size", "duration", "link", "bannerUrl", "status", "createdAt"])
                     && request.resource.data.advertiserName is string
                     && request.resource.data.advertiserName.size() > 0
                     && request.resource.data.bannerUrl is string
                     && existsAfter(/databases/$(database)/documents/ad_contacts/$(submissionId));
      allow read: if resource.data.status == "approved" || request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Private contact details of ad_submissions/{submissionId} (same id).
    match /ad_contacts/{submissionId} {
      allow create: if request.auth != null
                    || (request.resource.data.keys().hasOnly(["contactName", "phone", "email", "notes", "createdAt"])
                        && request.resource.data.email is string
                        && !exists(/databases/$(database)/documents/ad_submissions/$(submissionId))
                        && existsAfter(/databases/$(database)/documents/ad_submissions/$(submissionId))
                        && getAfter(/databases/$(database)/documents/ad_submissions/$(submissionId)).data.status == "pending");
      allow read, update, delete: if request.auth != null;
    }
  }
}
